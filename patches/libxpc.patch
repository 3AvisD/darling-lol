@@ -76,15 +139,25 @@ au_asid_t xpc_event_publisher_get_subscriber_asid(xpc_event_publisher_t xpub, ui
 
 XPC_EXPORT
 void xpc_event_publisher_set_error_handler(xpc_event_publisher_t xpub, void (^handler)()) {
-	// no clue what the parameters for the handler are
-	// (probably includes some sort of error parameter, but i have no clue what that is)
-	xpc_stub();
+	if (xpub == NULL)
+		return;
+	// The real signature takes a single `int error` argument.
+	// NOTE: use Block_copy(), NOT [handler copy]. The latter sends an ObjC
+	// message (objc_msgSend) which dereferences the block's isa; if the
+	// caller's blocks runtime leaves isa NULL/unmapped (observed: notifyd
+	// SEGV addr=0x0 inside [handler copy]), messaging crashes. Block_copy
+	// operates on the block struct directly and is safe.
+	xpub->error_handler = (void (^)(int)) Block_copy((const void*)handler);
 };
 
 XPC_EXPORT
 void xpc_event_publisher_set_handler(xpc_event_publisher_t xpub, void (^handler)()) {
-	// likewise, no clue what the parameters to the handler are
-	xpc_stub();
+	if (xpub == NULL)
+		return;
+	// The real signature is:
+	//   void (^)(xpc_event_publisher_action_t action,
+	//            uint64_t event_token, xpc_object_t descriptor)
+	xpub->handler = (void (^)(xpc_event_publisher_action_t, uint64_t, xpc_object_t)) Block_copy((const void*)handler);
 };
 
