+/*
+ * darling-lol: minimal but FUNCTIONAL event publisher.
+ *
+ * xpc_event_publisher_* was entirely stubbed (create -> NULL, set_handler
+ * -> dropped, activate -> no-op). That silently broke any daemon that gates
+ * its real initialization on the publisher's INITIAL_BARRIER callback.
+ *
+ * notifyd is exactly such a daemon: it creates the publisher for
+ * "com.apple.notifyd.matching" and only calls dispatch_mach_connect() for
+ * its Mach channels from inside the handler when it sees
+ * XPC_EVENT_PUBLISHER_ACTION_INITIAL_BARRIER. Because activate() did
+ * nothing, the barrier never fired, the channels were never connected, and
+ * the `com.apple.system.notification_center` Mach service registered with
+ * launchd was left without a serving endpoint. Clients then either hung in
+ * bootstrap/check-in or failed outright -- e.g. Chromium's
+ * ThermalStateObserverMac logged "unable to register to power
+ * notifications. Result: 9" (NOTIFY_STATUS_SERVER_NOT_FOUND).
+ *
+ * We do not need a real launchd-backed event stream here; we only need the
+ * lifecycle the server expects:
+ *   - create() gives back a usable object,
+ *   - set_handler()/set_error_handler() remember the blocks,
+ *   - activate() delivers the INITIAL_BARRIER action once, synchronously
+ *     (Apple delivers it asynchronously on the publisher's queue; sync is
+ *     sufficient for notifyd, which only needs its connects to happen
+ *     before dispatch_main()).
+ * ADD/REMOVE actions are only ever produced by launchd from registered
+ * event streams, which Darling does not have; they are not needed to bring
+ * notifyd's channels up.
+ */
+
+typedef struct _xpc_event_publisher_s {
+	const char* name;
+	dispatch_queue_t queue;
+	void (^handler)(xpc_event_publisher_action_t action, uint64_t event_token, xpc_object_t descriptor);
+	void (^error_handler)(int error);
+	bool activated;
+} *xpc_event_publisher_t;
+
 XPC_EXPORT
 void xpc_event_publisher_activate(xpc_event_publisher_t xpub) {
-	xpc_stub();
+	if (xpub == NULL || xpub->activated)
+		return;
+	xpub->activated = true;
+
+	void (^handler)(xpc_event_publisher_action_t, uint64_t, xpc_object_t) = xpub->handler;
+	if (handler == NULL)
+		// Nothing to deliver; without a handler there is no barrier
+		// contract to honor.
+		return;
+
+	// Deliver the barrier synchronously. Apple's real implementation
+	// delivers it asynchronously on the publisher's queue, but the only
+	// in-tree consumer (notifyd) just needs dispatch_mach_connect() to run
+	// before dispatch_main(); synchronous delivery satisfies that without
+	// depending on the queue being ready to run async blocks yet.
+	handler(XPC_EVENT_PUBLISHER_ACTION_INITIAL_BARRIER, 0, NULL);
 };
 
 XPC_EXPORT
 xpc_object_t xpc_event_publisher_create(const char* name, void* some_parameter) {
-	xpc_stub();
-	return NULL;
+	xpc_event_publisher_t xpub = calloc(1, sizeof(struct _xpc_event_publisher_s));
+	if (xpub == NULL)
+		return NULL;
+	xpub->name = name;
+	// Apple passes the workloop/queue as the second parameter; callers
+	// (notifyd) pass a dispatch queue. Retained for possible future async
+	// delivery; the current implementation delivers the barrier
+	// synchronously in activate().
+	xpub->queue = (dispatch_queue_t) some_parameter;
+	return (xpc_object_t) xpub;
 };
 
