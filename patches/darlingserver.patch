diff --git a/duct-tape/src/fileport.c b/duct-tape/src/fileport.c
new file mode 100644
index 0000000..1741d59
--- /dev/null
+++ b/duct-tape/src/fileport.c
@@ -0,0 +1,154 @@
+/*
+ * darling-lol M54: fileport support (fileport_makeport/fileport_makefd).
+ *
+ * Chromium's Mojo-on-Mac transports Unix FDs over Mach messages by wrapping
+ * them in fileports (mojo/core/channel_mac.cc, mojo/core/ipcz_driver/
+ * wrapped_platform_handle.cc). Without this, every FD-carrying Mojo message
+ * (e.g. NetworkService startup) dies in the old-LKM-API UD2 trap.
+ *
+ * A fileport is a Mach port whose kobject holds a host FD owned by
+ * darlingserver. The kobject rides the port across IPC transfer
+ * automatically, and ipc_kobject_destroy closes the FD when the port dies,
+ * so no transfer hooks or task-death cleanup are needed. fileport_makefd
+ * dups the held FD back to the caller (independent lifecycle, like XNU).
+ */
+
+#include <darlingserver/duct-tape.h>
+
+#include <kern/debug.h>
+#include <stdlib.h>
+#include <ipc/ipc_object.h>
+#include <ipc/ipc_port.h>
+#include <ipc/ipc_space.h>
+#include <ipc/ipc_entry.h>
+#include <kern/ipc_kobject.h>
+#include <mach/mach_port.h>
+#include <mach/message.h>
+
+/* duct-tape convention (see memory.c): declare libc bits manually rather
+ * than including host <unistd.h>, whose types collide with XNU headers. */
+int close(int fd);
+int dup(int fd);
+
+#include <darlingserver/duct-tape/task.h>
+#include <darlingserver/duct-tape/log.h>
+
+struct dtape_fileport {
+	int fd;
+};
+
+int dtape_fileport_makeport(dtape_task_t* task, int fd, uint32_t* name_out)
+{
+	struct dtape_fileport* fp;
+	ipc_port_t port;
+	mach_port_name_t name;
+
+	if (task == NULL || fd < 0 || name_out == NULL) {
+		return KERN_INVALID_ARGUMENT;
+	}
+	if (task->xnu_task.itk_space == IS_NULL) {
+		return KERN_INVALID_TASK;
+	}
+
+	fp = malloc(sizeof(*fp));
+	if (fp == NULL) {
+		dtape_log_error("fileport_makeport: malloc failed");
+		return KERN_RESOURCE_SHORTAGE;
+	}
+	fp->fd = fd;
+
+	/* Allocate a kernel-owned port holding the fd. As in XNU's
+	 * fileport_alloc(), the port comes back with a send right. */
+	port = ipc_kobject_alloc_port((ipc_kobject_t)fp, IKOT_FILEPORT,
+	    IPC_KOBJECT_ALLOC_MAKE_SEND | IPC_KOBJECT_ALLOC_NSREQUEST);
+	if (!IP_VALID(port)) {
+		dtape_log_error("fileport_makeport: ipc_kobject_alloc_port failed fd=%d", fd);
+		free(fp);
+		return KERN_RESOURCE_SHORTAGE;
+	}
+
+	/* Install the send right into the task's space and get a name.
+	 * ipc_port_copyout_send() is the XNU entry point for exactly this
+	 * (see sys_fileport_makeport); it consumes the send right, so we
+	 * must not release it afterwards. Do NOT go through
+	 * mach_port_insert_right(): its MACH_MSG_TYPE_PORT_ANY_RIGHT() guard
+	 * rejects MACH_MSG_TYPE_MAKE_SEND, which made every fileport fail
+	 * with KERN_INVALID_VALUE and broke all FD-carrying Mojo messages. */
+	name = ipc_port_copyout_send(port, task->xnu_task.itk_space);
+	if (!MACH_PORT_VALID(name)) {
+		dtape_log_error("fileport_makeport: ipc_port_copyout_send failed fd=%d", fd);
+		/* port consumed by copyout; its kobject destroy closes fp->fd */
+		return KERN_RESOURCE_SHORTAGE;
+	}
+
+	*name_out = (uint32_t)name;
+	return KERN_SUCCESS;
+}
+
+int dtape_fileport_makefd(dtape_task_t* task, uint32_t uname, int* fd_out)
+{
+	ipc_object_t object = IO_NULL;
+	mach_msg_type_name_t dtype = 0;
+	mach_port_name_t name = (mach_port_name_t)uname;
+	ipc_port_t port;
+	struct dtape_fileport* fp;
+	int fd;
+
+	if (task == NULL || fd_out == NULL) {
+		return KERN_INVALID_ARGUMENT;
+	}
+	if (task->xnu_task.itk_space == IS_NULL) {
+		return KERN_INVALID_TASK;
+	}
+
+	/* Copyin a send right: validates the name, checks aliveness, and
+	 * enforces that the right is a send right (receive/dead names fail).
+	 * Does not consume the caller's right. */
+	if (ipc_object_copyin(task->xnu_task.itk_space, name,
+	    MACH_MSG_TYPE_COPY_SEND, &object, 0, NULL,
+	    IPC_OBJECT_COPYIN_FLAGS_ALLOW_IMMOVABLE_SEND) != KERN_SUCCESS) {
+		return KERN_INVALID_RIGHT;
+	}
+	dtype = ipc_object_copyin_type(MACH_MSG_TYPE_COPY_SEND);
+
+	port = ip_object_to_port(object);
+	if (!IP_VALID(port) || ip_kotype(port) != IKOT_FILEPORT) {
+		ipc_object_destroy(object, dtype);
+		return KERN_INVALID_RIGHT;
+	}
+	fp = (struct dtape_fileport*)ip_get_kobject(port);
+	if (fp == NULL || fp->fd < 0) {
+		ipc_object_destroy(object, dtype);
+		return KERN_INVALID_RIGHT;
+	}
+
+	/* Independent lifecycle: the receiver owns the dup, the kobject
+	 * keeps its own. */
+	fd = dup(fp->fd);
+	ipc_object_destroy(object, dtype);
+	if (fd < 0) {
+		return KERN_RESOURCE_SHORTAGE;
+	}
+
+	*fd_out = fd;
+	return KERN_SUCCESS;
+}
+
+void dtape_fileport_destroy(ipc_port_t port)
+{
+	struct dtape_fileport* fp;
+
+	if (!IP_VALID(port)) {
+		return;
+	}
+	fp = (struct dtape_fileport*)ip_get_kobject(port);
+	if (fp == NULL) {
+		return;
+	}
+	/* Port is dead; just release our resources like
+	 * mach_destroy_memory_entry does. */
+	if (fp->fd >= 0) {
+		close(fp->fd);
+	}
+	free(fp);
+}
diff --git a/duct-tape/src/host.c b/duct-tape/src/host.c
index a841dfd..9fe8bb4 100644
--- a/duct-tape/src/host.c
+++ b/duct-tape/src/host.c
@@ -28,6 +28,64 @@ long sysconf(int name);
 #define _SC_NPROCESSORS_CONF 83
 #define _SC_NPROCESSORS_ONLN 84
 
+// Linux file access for the SMT topology read (manual prototypes, as for sysconf above)
+int open(const char* pathname, int flags, ...);
+long read(int fd, void* buf, unsigned long count);
+int close(int fd);
+
+// darling-lol: host_info used to report physical_cpu == logical_cpu, which
+// tells the guest there is no SMT. Read the sibling count of cpu0 from sysfs
+// and divide; on any failure keep the logical count. The per-CPU package/core
+// scan in the guest-side sysctl_hw.c is more precise, but host_info has no
+// other source for the physical count.
+static uint32_t host_smt_siblings(void) {
+	static uint32_t cached;
+	char buf[64];
+	uint32_t count = 0;
+	long n;
+
+	if (cached != 0) {
+		return cached;
+	}
+
+	int fd = open("/sys/devices/system/cpu/cpu0/topology/thread_siblings_list", 0 /* O_RDONLY */);
+	if (fd < 0) {
+		return 1;
+	}
+	n = read(fd, buf, sizeof(buf) - 1);
+	close(fd);
+	if (n <= 0) {
+		return 1;
+	}
+	buf[n] = 0;
+
+	// a list like "0,6" or "0-3": count one CPU per element, ranges as ranges
+	const char* s = buf;
+	while (*s >= '0' && *s <= '9') {
+		unsigned long first = 0, last;
+		while (*s >= '0' && *s <= '9') {
+			first = first * 10 + (unsigned long)(*s++ - '0');
+		}
+		last = first;
+		if (*s == '-') {
+			++s;
+			last = 0;
+			while (*s >= '0' && *s <= '9') {
+				last = last * 10 + (unsigned long)(*s++ - '0');
+			}
+		}
+		if (last >= first && last - first < 4096) {
+			count += (uint32_t)(last - first + 1);
+		}
+		if (*s == ',') {
+			++s;
+		}
+	}
+
+	cached = (count != 0) ? count : 1;
+	return cached;
+}
+
