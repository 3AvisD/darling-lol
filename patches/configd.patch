+/* Query the kernel's route selection without sending a packet. Match its
+ * local address against getifaddrs, rather than inventing a primary adapter. */
+static CFStringRef _primaryInterface(int family)
+{
+    struct sockaddr_storage remote = {0}, local = {0};
+    socklen_t size;
+    if (family == AF_INET) {
+        struct sockaddr_in *p = (struct sockaddr_in *)&remote;
+        p->sin_len = sizeof(*p); p->sin_family = family; p->sin_port = htons(53);
+        inet_pton(family, "8.8.8.8", &p->sin_addr); size = sizeof(*p);
+    } else {
+        struct sockaddr_in6 *p = (struct sockaddr_in6 *)&remote;
+        p->sin6_len = sizeof(*p); p->sin6_family = family; p->sin6_port = htons(53);
+        inet_pton(family, "2001:4860:4860::8888", &p->sin6_addr); size = sizeof(*p);
+    }
+    int fd = socket(family, SOCK_DGRAM, 0);
+    if (fd < 0) return NULL;
+    socklen_t localSize = sizeof(local);
+    int result = connect(fd, (struct sockaddr *)&remote, size);
+    if (!result) result = getsockname(fd, (struct sockaddr *)&local, &localSize);
+    close(fd);
+    if (result) return NULL;
+    struct ifaddrs *interfaces = NULL;
+    if (getifaddrs(&interfaces)) return NULL;
+    CFStringRef name = NULL;
+    for (struct ifaddrs *p = interfaces; p; p = p->ifa_next) {
+        if (!p->ifa_addr || p->ifa_addr->sa_family != family ||
+            !(p->ifa_flags & IFF_UP) || (p->ifa_flags & IFF_LOOPBACK)) continue;
+        const void *a, *b;
+        size_t bytes;
+        if (family == AF_INET) {
+            a = &((struct sockaddr_in *)p->ifa_addr)->sin_addr;
+            b = &((struct sockaddr_in *)&local)->sin_addr; bytes = sizeof(struct in_addr);
+        } else {
+            a = &((struct sockaddr_in6 *)p->ifa_addr)->sin6_addr;
+            b = &((struct sockaddr_in6 *)&local)->sin6_addr; bytes = sizeof(struct in6_addr);
+        }
+        if (!memcmp(a, b, bytes)) {
+            name = CFStringCreateWithCString(NULL, p->ifa_name, kCFStringEncodingUTF8);
+            break;
+        }
+    }
+    freeifaddrs(interfaces);
+    return name;
 }
 
