+/*
+ * darling-lol: minimal but FUNCTIONAL network reachability.
+ *
+ * Previously every SCNetworkReachability* entry point was a stub:
+ * CreateWithAddress/Name returned NULL and GetFlags returned garbage.
+ * Chromium's network_change_notifier_mac / dns_config_service start by
+ * creating a reachability object and calling GetFlags; with NULL/garbage
+ * it took a failing path (and `dns_config_service_posix ... watch failed
+ * to start` / `Could not get initial network connection type` follow).
+ *
+ * Darling has no reachability subsystem, but the honest answer for a host
+ * that has a working network stack is "reachable, direct". We return a
+ * real heap object so callers can schedule it, and GetFlags reports
+ * kSCNetworkReachabilityFlagsReachable. If the host is genuinely offline
+ * the caller finds out when its connect() fails; this only removes the
+ * false negative at startup.
+ */
+struct __SCNetworkReachability {
+	CFRuntimeBase _base;
+	CFStringRef name;
+	struct sockaddr_storage addr;
+	Boolean hasAddr;
+};
+
+static void _reachabilityRelease(CFTypeRef cf)
+{
+	struct __SCNetworkReachability* ref = (struct __SCNetworkReachability*) cf;
+	if (ref->name != NULL)
+		CFRelease(ref->name);
+}
+
+static CFStringRef _reachabilityCopyDescription(CFTypeRef cf)
+{
+	return CFSTR("SCNetworkReachability");
+}
+
+static const CFRuntimeClass _reachabilityClass = {
+	0,
+	"SCNetworkReachability",
+	NULL, /* init */
+	NULL, /* copy */
+	_reachabilityRelease,
+	NULL, /* equal */
+	NULL, /* hash */
+	NULL, /* copyFormattingDesc */
+	_reachabilityCopyDescription
+};
+
+static SCNetworkReachabilityRef _reachabilityCreate(CFAllocatorRef allocator, const struct sockaddr* addr)
+{
+	static CFTypeID classID = _kCFRuntimeNotATypeID;
+	if (classID == _kCFRuntimeNotATypeID)
+		classID = _CFRuntimeRegisterClass(&_reachabilityClass);
+
+	struct __SCNetworkReachability* ref = (struct __SCNetworkReachability*)
+		_CFRuntimeCreateInstance(allocator, classID,
+			sizeof(struct __SCNetworkReachability) - sizeof(CFRuntimeBase), NULL);
+	if (ref == NULL)
+		return NULL;
+
+	if (addr != NULL) {
+		size_t len = sizeof(struct sockaddr_in);
+		if (addr->sa_family == AF_INET6)
+			len = sizeof(struct sockaddr_in6);
+		if (len > sizeof(ref->addr))
+			len = sizeof(ref->addr);
+		memcpy(&ref->addr, addr, len);
+		ref->hasAddr = true;
+	}
+	return (SCNetworkReachabilityRef) ref;
+}
