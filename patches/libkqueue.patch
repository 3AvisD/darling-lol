 //TODO: knote_enable()
 
+
+struct knote *
+knote_lookup_fd_specific(struct filter *filt,uintptr_t ident,uint64_t udata) {
+    struct knote query={0};
+    query.kev.ident=ident;query.kev.filter=filt->kf_id;
+    query.kev.flags=EV_UDATA_SPECIFIC;query.kev.udata=udata;
